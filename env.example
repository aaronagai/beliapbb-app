# Copy to .env.local for Vite (optional). Never commit real keys.

# Local constitution RAG API (Express): server reads this automatically if you use dotenv — otherwise export in shell:
# OPENAI_API_KEY=sk-...

# Production / GitHub Pages: absolute URL of your deployed API (no trailing slash)
# VITE_CONSTITUTION_CHAT_API=https://your-service.example.com

# Analytics (PostHog, US cloud): visits and a few named actions, no cookies, nothing typed into forms.
# The "Belia PBB" project token is built in (it is public by design). Set VITE_POSTHOG_KEY only to
# point a build at a different PostHog project. Analytics only run on beliapbb.com / app.beliapbb.com.
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
