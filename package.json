{
  "name": "beliapbb-app",
  "private": true,
  "version": "0.0.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/server.mjs",
    "dev:full": "concurrently -k \"npm run dev\" \"npm run dev:api\"",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs combined dist",
    "preview": "vite preview",
    "ingest:constitution": "node scripts/ingest-constitution.mjs",
    "ingest:ftes": "node scripts/ingest-ftes.mjs",
    "chat:chunks": "node scripts/build-chat-chunks.mjs",
    "build:site": "tsc --noEmit && VITE_BUILD_TARGET=site vite build --outDir dist-site && node scripts/postbuild.mjs site dist-site",
    "build:app": "tsc --noEmit && VITE_BUILD_TARGET=app vite build --outDir dist-app && node scripts/postbuild.mjs app dist-app"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "openai": "^4.83.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "pdf-parse": "^1.1.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.4"
  }
}
